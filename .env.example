# Generate unique values with python scripts/init_env.py. Never commit .env.
POSTGRES_PASSWORD=
JWT_SECRET=
INTERNAL_API_KEY=
# Local Python overrides; Compose overrides DATABASE_URL and service paths.
DATABASE_URL=sqlite:///./data/roadscope.db
MEDIA_DIR=data/media
INFERENCE_URL=http://127.0.0.1:8001
DEMO_MODE=true
INFERENCE_MODE=demo
INSTALL_YOLO=false
MODEL_CARD=models/model-card.json
CONFIDENCE_THRESHOLD=0.35
NMS_IOU=0.5
MAX_UPLOAD_MB=100
MAX_VIDEO_SECONDS=300
MAX_FRAMES=150
FRAME_INTERVAL_SECONDS=2
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
# Optional provenanced expert calibration JSON; mount it in worker for Compose.
# CALIBRATION_PATH=models/calibration.json

