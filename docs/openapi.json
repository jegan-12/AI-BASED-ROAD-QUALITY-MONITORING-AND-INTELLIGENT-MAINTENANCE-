    "/api/defects": {
      "get": {
        "tags": [
          "defects"
        ],
        "summary": "Defects",
        "operationId": "defects_api_defects_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 2000,
              "minimum": 1,
              "default": 200,
              "title": "Limit"
            }
